PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/creatarsh
MANAGER_JWT_SECRET=replace-with-a-long-random-secret
CUSTOMER_JWT_SECRET=replace-with-a-different-long-random-secret
MANAGER_INITIAL_USERNAME=admin
MANAGER_INITIAL_PASSWORD=replace-with-a-strong-initial-password
MANAGER_JWT_EXPIRES=90d
CUSTOMER_JWT_EXPIRES=90d
# Comma-separated origins if the customer/manager frontend is hosted separately from the API.
# Example: https://creatarsh.in,https://www.creatarsh.in
CORS_ORIGINS=https://creatarsh.in,https://www.creatarsh.in
