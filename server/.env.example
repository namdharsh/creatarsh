# Copy this file to server/.env for local development.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/creatarsh
CORS_ORIGINS=http://localhost:5000

# Local-only development secrets. Replace with independent random secrets in production.
MANAGER_JWT_SECRET=local-development-manager-secret-change-before-production
CUSTOMER_JWT_SECRET=local-development-customer-secret-change-before-production
MANAGER_JWT_EXPIRES=12h
CUSTOMER_JWT_EXPIRES=7d
CUSTOMER_SESSION_DAYS=30

MANAGER_INITIAL_USERNAME=admin
MANAGER_INITIAL_PASSWORD=change-this-local-password

CUSTOMER_EMAIL_VERIFICATION_REQUIRED=false
PUBLIC_APP_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CUSTOMER_PHONE_VERIFICATION_REQUIRED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
