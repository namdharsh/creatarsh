# Required in production. Use two different long random secrets.
MANAGER_JWT_SECRET=replace-with-a-long-random-secret
CUSTOMER_JWT_SECRET=replace-with-a-different-long-random-secret
CUSTOMER_JWT_EXPIRES=30d
CUSTOMER_SESSION_DAYS=30

# Optional email verification. If true, configure SMTP before enabling.
CUSTOMER_EMAIL_VERIFICATION_REQUIRED=false
PUBLIC_APP_URL=https://creatarsh.in
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional phone verification. Provide a trusted SMS HTTP endpoint accepting
# { to, message } and a bearer token. Keep these values server-side.
CUSTOMER_PHONE_VERIFICATION_REQUIRED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
