# Copy to .env locally. Replace placeholders in your local environment only. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=<MONGODB_CONNECTION_STRING>
MANAGER_JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARS>
CUSTOMER_JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARS>
MANAGER_INITIAL_USERNAME=<INITIAL_MANAGER_USERNAME>
MANAGER_INITIAL_PASSWORD=<INITIAL_MANAGER_PASSWORD>
MANAGER_JWT_EXPIRES=12h
CUSTOMER_JWT_EXPIRES=7d
CORS_ORIGINS=https://creatarsh.in,https://www.creatarsh.in
RAZORPAY_KEY_ID=<RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<RAZORPAY_WEBHOOK_SECRET>
TRUSTED_PROXY_COUNT=1
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
LOG_LEVEL=info

# Optional business profile media uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# Private S3-compatible object storage for publisher source ZIPs and static releases
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=<OBJECT_STORAGE_REGION>
OBJECT_STORAGE_BUCKET=<PRIVATE_OBJECT_STORAGE_BUCKET>
OBJECT_STORAGE_ACCESS_KEY_ID=<OBJECT_STORAGE_ACCESS_KEY_ID>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<OBJECT_STORAGE_SECRET_ACCESS_KEY>
PLATFORM_ROOT_DOMAIN=creatarsh.in
PUBLISHER_MAX_UPLOAD_BYTES=20971520
PUBLISHER_MAX_UNPACKED_BYTES=62914560

# Optional bootstrap for a separate admin account (created only if username does not exist)
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
# Set a unique random value in production to hash audit source IPs
AUDIT_IP_SALT=replace-with-a-long-random-value
