# Copy to server/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/creatarsh
MANAGER_JWT_SECRET=replace-with-a-random-development-secret-at-least-32-characters
CUSTOMER_JWT_SECRET=replace-with-a-different-random-development-secret-at-least-32-characters
MANAGER_JWT_EXPIRES=12h
CUSTOMER_JWT_EXPIRES=7d
MANAGER_INITIAL_USERNAME=manager
MANAGER_INITIAL_PASSWORD=replace-this-local-password
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-this-local-admin-password
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
TRUSTED_PROXY_COUNT=0
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
PLATFORM_ROOT_DOMAIN=creatarsh.in
# Private object storage (optional until website publishing is configured)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Cloudinary (optional until business media uploads are configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Razorpay Test Mode only; keep server-side
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
DEFAULT_GST_RATE=18
# Set a unique random value for production audit IP hashing
AUDIT_IP_SALT=replace-with-random-salt
